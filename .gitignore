```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Cache directories
.cache/
.npm/
.yarn/

# Logs
*.log

# Environment variables
.env
.env.local
*.env

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
*.coverage

# Temporary files
*.tmp
*.temp
```